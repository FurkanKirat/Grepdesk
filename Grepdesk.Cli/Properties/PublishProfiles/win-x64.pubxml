<!--
  Published alongside Grepdesk.UI into publish\win-x64\ so the installer and
  portable archive ship grepdesk.exe next to Grepdesk.UI.exe.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
