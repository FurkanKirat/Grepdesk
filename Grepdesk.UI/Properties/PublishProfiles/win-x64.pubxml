<!--
  The build the installer ships: `dotnet publish Grepdesk.UI -p:PublishProfile=win-x64`,
  then compile setup.iss. Self-contained, so it runs on machines without .NET
  installed. Not trimmed: Avalonia, AvaloniaEdit and the COM interop rely on
  reflection that trimming would break.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
