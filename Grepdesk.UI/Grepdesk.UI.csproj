<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Sets the .exe / taskbar / Explorer icon on Windows builds. Must be an .ico file. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Precompiled code: job windows are short-lived processes started from
         Explorer, so JIT time is a large share of their run time. Applies to
         `dotnet publish -r <rid>` only. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <!-- Syntax highlighting in the viewer's editor: VS Code's grammars and themes. -->
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.4.1" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grepdesk.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Target platform resolution: from RuntimeIdentifier or host OS -->
    <TargetPlatform Condition="'$(TargetPlatform)' == '' and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">windows</TargetPlatform>
    <TargetPlatform Condition="'$(TargetPlatform)' == '' and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">linux</TargetPlatform>
    <TargetPlatform Condition="'$(TargetPlatform)' == '' and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">macos</TargetPlatform>

    <!-- Fallback to current host OS if no RuntimeIdentifier was specified -->
    <TargetPlatform Condition="'$(TargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</TargetPlatform>
    <TargetPlatform Condition="'$(TargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</TargetPlatform>
    <TargetPlatform Condition="'$(TargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">macos</TargetPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grepdesk.Core\Grepdesk.Core.csproj" />
  </ItemGroup>

  <!-- Platform-specific project references and compiler defines -->
  <ItemGroup Condition="'$(TargetPlatform)' == 'windows'">
    <ProjectReference Include="..\Grepdesk.Windows\Grepdesk.Windows.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetPlatform)' == 'windows'">
    <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetPlatform)' == 'linux'">
    <ProjectReference Include="..\Grepdesk.Linux\Grepdesk.Linux.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetPlatform)' == 'linux'">
    <DefineConstants>$(DefineConstants);PLATFORM_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetPlatform)' == 'macos'">
    <ProjectReference Include="..\Grepdesk.MacOS\Grepdesk.MacOS.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetPlatform)' == 'macos'">
    <DefineConstants>$(DefineConstants);PLATFORM_MACOS</DefineConstants>
  </PropertyGroup>

  <!-- Makes Assets/icon.ico loadable at runtime via avares://, for the window/title-bar icon. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="Assets\Lang\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
