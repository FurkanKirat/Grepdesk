<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Sets the .exe / taskbar / Explorer icon on Windows builds. Must be an .ico file. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Precompiled code: job windows are short-lived processes started from
         Explorer, so JIT time is a large share of their run time. Applies to
         `dotnet publish -r <rid>` only. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grepdesk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grepdesk.Core\Grepdesk.Core.csproj" />
    <ProjectReference Include="..\Grepdesk.Linux\Grepdesk.Linux.csproj" />
    <ProjectReference Include="..\Grepdesk.MacOS\Grepdesk.MacOS.csproj" />
    <ProjectReference Include="..\Grepdesk.Windows\Grepdesk.Windows.csproj" />
  </ItemGroup>

  <!-- Makes Assets/icon.ico loadable at runtime via avares://, for the window/title-bar icon. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  
	<ItemGroup>
		<None Include="Assets\Lang\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
