<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="Grepdesk.UI.Viewer.FileViewerWindow"
        Title="Grepdesk"
        Width="1000"
        Height="740"
        MinWidth="480"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Icon="avares://Grepdesk.UI/Assets/icon.ico"
        Background="#11111b">

    <!-- The media view's seek and volume bars in the app's blue, not the system accent. -->
    <Window.Resources>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#89b4fa"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#b4befe"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#b4befe"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#89b4fa"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#b4befe"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#b4befe"/>
        <SolidColorBrush x:Key="SliderTrackFill" Color="#45475a"/>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#585b70"/>
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#585b70"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button, ToggleButton">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#45475a"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#11111b"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#b4befe"/>
            <Setter Property="Foreground" Value="#11111b"/>
        </Style>
        <Style Selector="Button.compact, ToggleButton.compact">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style Selector="Button.status, ToggleButton.status">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style Selector="Button.status:pointerover /template/ ContentPresenter, ToggleButton.status:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
        </Style>
        <Style Selector="ToggleButton.status:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#45475a"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
        </Style>
        <Style Selector="TextBox.findInput">
            <Setter Property="Background" Value="#11111b"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.findInput.invalid">
            <Setter Property="BorderBrush" Value="#f38ba8"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Header: what the file is, and the few things you can do with it -->
        <Border DockPanel.Dock="Top"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="NameText"
                               Foreground="#cdd6f4"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="InfoText"
                               Foreground="#6c7086"
                               FontSize="11"
                               TextTrimming="PathSegmentEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Foreground="#a6e3a1"
                               FontSize="12"
                               VerticalAlignment="Center"
                               IsVisible="False"/>
                    <Button x:Name="PrevFileButton" Content="‹" MinWidth="32" HorizontalContentAlignment="Center"/>
                    <Button x:Name="NextFileButton" Content="›" MinWidth="32" HorizontalContentAlignment="Center"/>
                    <Button x:Name="FindButton" IsVisible="False"/>
                    <Button x:Name="OutlineButton" IsVisible="False"/>
                    <Button x:Name="FormatButton" IsVisible="False"/>
                    <ToggleButton x:Name="RenderedToggle" IsVisible="False"/>
                    <ToggleButton x:Name="WrapToggle" IsVisible="False"/>
                    <ToggleButton x:Name="EditToggle" IsVisible="False"/>
                    <Button x:Name="SaveButton" Classes="primary" IsVisible="False"/>
                    <Button x:Name="OpenButton"/>
                    <Button x:Name="ShowInFolderButton"/>
                </StackPanel>
            </Grid>
        </Border>

        <Panel Background="#11111b">
            <DockPanel x:Name="EditorContainer" IsVisible="False">
                <!-- Find / Replace / Go to Line bar -->
                <Border x:Name="EditorFindBar"
                        DockPanel.Dock="Top"
                        Background="#181825"
                        BorderBrush="#313244"
                        BorderThickness="0,0,0,1"
                        Padding="12,7"
                        IsVisible="False">
                    <StackPanel Spacing="6">
                        <StackPanel x:Name="FindRow" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBox x:Name="FindBox" Classes="findInput" Width="250"/>
                            <ToggleButton x:Name="MatchCaseToggle" Classes="compact" Content="Aa"/>
                            <ToggleButton x:Name="WholeWordToggle" Classes="compact" Content="W"/>
                            <ToggleButton x:Name="RegexToggle" Classes="compact" Content=".*"/>
                            <TextBlock x:Name="FindCountText"
                                       Foreground="#6c7086"
                                       FontSize="11.5"
                                       MinWidth="76"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                            <Button x:Name="FindPrevButton" Classes="compact" Content="↑" MinWidth="28" HorizontalContentAlignment="Center"/>
                            <Button x:Name="FindNextButton" Classes="compact" Content="↓" MinWidth="28" HorizontalContentAlignment="Center"/>
                            <Button x:Name="CloseFindButton" Classes="compact" Content="✕" MinWidth="28" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="False">
                            <TextBox x:Name="ReplaceBox" Classes="findInput" Width="250"/>
                            <Button x:Name="ReplaceButton" Classes="compact"/>
                            <Button x:Name="ReplaceAllButton" Classes="compact"/>
                        </StackPanel>
                        <StackPanel x:Name="GoToLineRow" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="False">
                            <TextBox x:Name="GoToLineBox" Classes="findInput" Width="170"/>
                            <Button x:Name="GoToLineButton" Classes="primary compact"/>
                            <Button x:Name="CloseGoToLineButton" Classes="compact" Content="✕" MinWidth="28" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- IDE bottom status bar -->
                <Border x:Name="EditorStatusBar"
                        DockPanel.Dock="Bottom"
                        Background="#181825"
                        BorderBrush="#313244"
                        BorderThickness="0,1,0,0"
                        Padding="10,4">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="CursorPosButton" Classes="status"/>
                            <Button x:Name="SymbolCrumbButton" Classes="status" IsVisible="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ToggleButton x:Name="WhitespaceToggle" Classes="status" Content="·"/>
                            <TextBlock x:Name="IndentText"
                                       Foreground="#6c7086"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                            <Button x:Name="LineEndingButton" Classes="status"/>
                            <Button x:Name="EncodingButton" Classes="status"/>
                            <Button x:Name="EditorZoomButton" Classes="status" Content="100%"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ae:TextEditor x:Name="Editor"
                               IsReadOnly="True"
                               ShowLineNumbers="True"
                               FontSize="12.5"
                               Background="#11111b"
                               Foreground="#bac2de"
                               LineNumbersForeground="#585b70"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               Padding="8,6"/>
            </DockPanel>

            <ScrollViewer x:Name="MarkdownScroll" IsVisible="False">
                <StackPanel MaxWidth="860" Margin="28,20" Spacing="10">
                    <ContentControl x:Name="MarkdownHost"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Image, PDF and media views -->
            <ContentControl x:Name="BodyHost" IsVisible="False"/>

            <!-- Loading, problems, and the summary card for files nothing here can show -->
            <StackPanel x:Name="MessagePanel"
                        Spacing="14"
                        MaxWidth="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Image x:Name="MessageImage" MaxWidth="256" MaxHeight="256" IsVisible="False"/>
                <TextBlock x:Name="MessageText"
                           Foreground="#6c7086"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <ItemsControl x:Name="MessageDetails" HorizontalAlignment="Center"/>
            </StackPanel>
        </Panel>
    </DockPanel>
</Window>
