<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Grepdesk.UI.PreviewPane">

    <Border Background="#181825"
            BorderBrush="#313244"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
        <Panel>
            <TextBlock x:Name="EmptyText"
                       Foreground="#6c7086"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <DockPanel x:Name="Details" IsVisible="False">
                <!-- Header: icon, name, location -->
                <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <Panel HorizontalAlignment="Left">
                        <PathIcon x:Name="FolderIcon" Data="{StaticResource IconFolder}" Width="34" Height="34" Foreground="#f9e2af" IsVisible="False"/>
                        <PathIcon x:Name="DocumentIcon" Data="{StaticResource IconDocument}" Width="30" Height="30" Foreground="#89b4fa" IsVisible="False"/>
                        <Border x:Name="Badge" CornerRadius="5" BorderThickness="1" Padding="8,5" IsVisible="False">
                            <TextBlock x:Name="BadgeText" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Panel>
                    <SelectableTextBlock x:Name="NameText"
                                         Foreground="#cdd6f4"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap"/>
                    <SelectableTextBlock x:Name="PathText"
                                         Foreground="#6c7086"
                                         FontSize="11"
                                         TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Metadata rows are filled in code: common ones plus whatever the previewer adds -->
                <Grid x:Name="MetaGrid" DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,12,0,0"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button x:Name="OpenButton"/>
                    <Button x:Name="ShowInFolderButton"/>
                </StackPanel>

                <!-- Body: image, text, rendered Markdown, or a note when there's nothing to show -->
                <Border Margin="0,12,0,0"
                        Background="#11111b"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Panel>
                        <Image x:Name="ImagePreview"
                               Stretch="Uniform"
                               StretchDirection="DownOnly"
                               Margin="6"
                               IsVisible="False"/>
                        <ScrollViewer x:Name="TextScroll" IsVisible="False">
                            <SelectableTextBlock x:Name="TextPreview"
                                                 Foreground="#bac2de"
                                                 FontSize="12"
                                                 Margin="10,8"
                                                 TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <ScrollViewer x:Name="MarkdownScroll" IsVisible="False">
                            <StackPanel Margin="12,10" Spacing="10">
                                <ContentControl x:Name="MarkdownHost"/>
                                <TextBlock x:Name="MarkdownFooter" Foreground="#6c7086" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="BodyMessage"
                                   Foreground="#6c7086"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Panel>
                </Border>
            </DockPanel>
        </Panel>
    </Border>
</UserControl>
