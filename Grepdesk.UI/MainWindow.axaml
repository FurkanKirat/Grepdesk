<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Grepdesk.UI"
        x:Class="Grepdesk.UI.MainWindow"
        Title="FileSearch"
        Width="800" Height="600"
        MinWidth="500" MinHeight="300"
        Background="#1e1e2e">

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#cdd6f4"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#a6adc8"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Shared template for both file-name and content search results.
             Snippet TextBlock is bound to ResultItem.Snippet; when Snippet is
             null/empty it collapses via IsVisible binding with a converter,
             so Tab 1 (no snippet) and Tab 2 (with snippet) can share one template. -->
        <DataTemplate x:Key="ResultItemTemplate" x:DataType="ui:ResultItem">
            <DockPanel Margin="4,3" ToolTip.Tip="{Binding FullPath}">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Icon}"
                           FontSize="16"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="{Binding FileName}"
                               Foreground="#cdd6f4"
                               FontSize="13"
                               FontWeight="Medium"/>
                    <TextBlock Text="{Binding Directory}"
                               Foreground="#6c7086"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Snippet}"
                               Foreground="#89b4fa"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasSnippet}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
    <WrapPanel x:Name="ExplorerMenuPanel"
               DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               IsVisible="False">
        <TextBlock x:Name="ExplorerMenuLabel"
                   Text="Explorer menu:"
                   Foreground="#a6adc8"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        <CheckBox x:Name="MenuOpenWithCheckBox" FontSize="12" Margin="0,0,12,0"/>
        <CheckBox x:Name="MenuExtractCheckBox" FontSize="12" Margin="0,0,12,0"/>
        <CheckBox x:Name="MenuCompressCheckBox" FontSize="12" Margin="0,0,12,0"/>
        <CheckBox x:Name="MenuPasteCheckBox" FontSize="12"/>
    </WrapPanel>

    <TabControl Background="Transparent">

        <!-- ===================== TAB 1 : FILE NAME SEARCH ===================== -->
        <TabItem x:Name="FileNameSearchTabItem" Header="File Name Search">
            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox"
                             Watermark="Search files and folders..."
                             FontSize="16"
                             Padding="10,8"
                             Background="#313244"
                             Foreground="White"
                             BorderBrush="#45475a"
                             CornerRadius="6"/>

                    <DockPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="Choose an option to start scanning"
                                   Foreground="#a6adc8"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="ChooseFolderButton" Content="Choose Folder..."/>
                            <Button x:Name="ScanAllButton" Content="Scan Entire PC"/>
                            <Button x:Name="ReindexButton" Content="Rescan" IsEnabled="False"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <ListBox x:Name="ResultsList"
                         Background="#181825"
                         BorderBrush="#313244"
                         BorderThickness="1"
                         CornerRadius="6"
                         ItemTemplate="{StaticResource ResultItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </TabItem>

        <!-- ===================== TAB 2 : CONTENT SEARCH ===================== -->
        <TabItem x:Name="ContentSearchTabItem" Header="Content Search">
            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">

                    <DockPanel>
                        <TextBlock Text="Folder to search:"
                                   Foreground="#a6adc8"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   DockPanel.Dock="Left"/>
                        <Button x:Name="ContentChooseFolderButton"
                                Content="Choose Folder..."
                                DockPanel.Dock="Right"/>
                        <TextBlock x:Name="ContentFolderText"
                                   Text="(not selected)"
                                   Foreground="#cdd6f4"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBox x:Name="ContentSearchBox"
                             Watermark="Text to search inside files — press Enter..."
                             FontSize="16"
                             Padding="10,8"
                             Background="#313244"
                             Foreground="White"
                             BorderBrush="#45475a"
                             CornerRadius="6"/>

                    <DockPanel>
                        <TextBlock x:Name="ContentStatusText"
                                   Text="Select a folder first"
                                   Foreground="#a6adc8"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SupportedFormatsText"
                                   DockPanel.Dock="Right"
                                   Text="Supported: .txt .md .cs .json .html .docx .xlsx .pdf(*) etc."
                                   Foreground="#6c7086"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <ListBox x:Name="ContentResultsList"
                         Background="#181825"
                         BorderBrush="#313244"
                         BorderThickness="1"
                         CornerRadius="6"
                         ItemTemplate="{StaticResource ResultItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </TabItem>

    </TabControl>
    </DockPanel>
</Window>
