<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="using:Grepdesk.UI.Organize"
             x:Class="Grepdesk.UI.Organize.OrganizeView"
             DragDrop.AllowDrop="True"
             Background="Transparent">

    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Classes="pageTitle"/>
            <TextBlock x:Name="SubtitleText" Classes="pageSubtitle"/>
        </StackPanel>

        <!-- Folder -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button x:Name="DownloadsButton"/>
                    <Button x:Name="ChooseButton"/>
                    <Button x:Name="RefreshButton" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="FolderLabel" Classes="label" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                <TextBlock x:Name="FolderText" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Grouping mode + status -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Classes="label" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                <Button x:Name="UndoButton" IsVisible="False" Padding="10,3" FontSize="12"/>
            </StackPanel>
            <ListBox x:Name="ModeList" Classes="chips"/>
        </DockPanel>

        <Panel>
            <Border x:Name="EmptyState" Classes="card" Padding="24">
                <TextBlock x:Name="EmptyText" Foreground="#7f849c" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"/>
            </Border>

            <Grid x:Name="Body" ColumnDefinitions="330,*" IsVisible="False">
                <!-- Groups -->
                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Classes="hint" Margin="2,0,0,8"/>
                    <ListBox x:Name="GroupList" Classes="suggestions">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="o:GroupRow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" Foreground="#cdd6f4" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#7f849c" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#cdd6f4" FontSize="14"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Members of the selected group -->
                <Border Grid.Column="1" Classes="card" Padding="16,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
                            <TextBlock x:Name="DetailTitle" Classes="sectionTitle" FontSize="16" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DetailText" Foreground="#a6adc8" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Actions -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button x:Name="TrashButton" DockPanel.Dock="Right" Classes="danger" Margin="8,0,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="FolderNameBox" MinWidth="200" FontSize="12" VerticalContentAlignment="Center"
                                         Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a" CornerRadius="6"/>
                                <Button x:Name="MoveButton"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Shown while typing a folder name that already exists -->
                        <TextBlock x:Name="TargetHint" DockPanel.Dock="Bottom" FontSize="11.5" TextWrapping="Wrap"
                                   Margin="0,8,0,0" IsVisible="False"/>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                            <Button x:Name="SelectAllButton" Padding="10,3" FontSize="12"/>
                            <Button x:Name="SelectNoneButton" Padding="10,3" FontSize="12"/>
                            <TextBlock x:Name="SelectionText" Classes="label" Margin="6,0,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="MemberList" Classes="results">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="o:MemberRow">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ToolTip.Tip="{Binding Member.Path}">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" MinWidth="0" Margin="0,0,6,0"
                                                  VerticalAlignment="Center"/>
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconFolder}" Width="14" Height="14"
                                                  Foreground="#f9e2af" Margin="0,0,8,0" IsVisible="{Binding IsFolder}"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="#cdd6f4" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#6c7086" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="#cdd6f4" FontSize="12"
                                                   VerticalAlignment="Center" Margin="12,0,8,0" MinWidth="64" TextAlignment="Right"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Classes="rowAction" Tag="show" ToolTip.Tip="{Binding ShowTip}">
                                                <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13"/>
                                            </Button>
                                            <Button Classes="rowAction" Tag="open" ToolTip.Tip="{Binding OpenTip}">
                                                <PathIcon Data="{StaticResource IconOpen}" Width="12" Height="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Panel>
    </DockPanel>
</UserControl>
