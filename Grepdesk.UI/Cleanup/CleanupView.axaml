<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Grepdesk.UI.Cleanup"
             x:Class="Grepdesk.UI.Cleanup.CleanupView">

    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Classes="pageTitle"/>
            <TextBlock x:Name="SubtitleText" Classes="pageSubtitle"/>
        </StackPanel>

        <!-- Drive + scan -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button x:Name="ScanButton"/>
                    <Button x:Name="CancelButton" IsVisible="False"/>
                </StackPanel>
                <TextBlock x:Name="DriveLabel" Classes="label" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                <ComboBox x:Name="DriveBox" DockPanel.Dock="Left" MinWidth="200" FontSize="12" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" Classes="label" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Panel>
            <Border x:Name="EmptyState" Classes="card" Padding="24">
                <TextBlock x:Name="EmptyText" Foreground="#7f849c" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"/>
            </Border>

            <Grid x:Name="Body" ColumnDefinitions="330,*" IsVisible="False">
                <!-- Suggestions -->
                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock x:Name="TotalText" Foreground="#cdd6f4" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalHint" Classes="hint"/>
                    </StackPanel>
                    <ListBox x:Name="SuggestionList" Classes="suggestions">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="c:SuggestionRow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" Foreground="#cdd6f4" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="#7f849c" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#cdd6f4" FontSize="15"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Details of the selected suggestion -->
                <Border Grid.Column="1" Classes="card" Padding="16,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                            <TextBlock x:Name="DetailTitle" Classes="sectionTitle" FontSize="16"/>
                            <TextBlock x:Name="DetailText" Foreground="#a6adc8" FontSize="12" TextWrapping="Wrap"/>
                            <Border x:Name="NoticeBox" Classes="notice">
                                <TextBlock x:Name="NoticeText" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <!-- Actions -->
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button x:Name="ActionButton" Classes="danger" Margin="0,0,8,0"/>
                            <Button x:Name="FindDuplicatesButton" Margin="0,0,8,0" IsVisible="False"/>
                            <Button x:Name="AskButton" Margin="0,0,8,0"/>
                            <Button x:Name="ToolButton1" Margin="0,0,8,0" IsVisible="False"/>
                            <Button x:Name="ToolButton2" Margin="0,0,8,0" IsVisible="False"/>
                            <Button x:Name="ToolButton3" Margin="0,0,8,0" IsVisible="False"/>
                        </WrapPanel>

                        <StackPanel x:Name="SelectionBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                            <Button x:Name="SelectAllButton" Padding="10,3" FontSize="12"/>
                            <Button x:Name="SelectNoneButton" Padding="10,3" FontSize="12"/>
                            <TextBlock x:Name="SelectionText" Classes="label" Margin="6,0,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="ItemList" Classes="results">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="c:ItemRow">
                                    <Panel>
                                        <!-- Group header (duplicates) -->
                                        <TextBlock IsVisible="{Binding IsHeader}" Text="{Binding Name}"
                                                   Foreground="#f9e2af" FontSize="11.5" FontWeight="SemiBold" Margin="4,8,0,2"/>
                                        <Grid IsVisible="{Binding IsItem}" ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{Binding Item.Path}">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}"
                                                      IsVisible="{Binding CanCheck}" MinWidth="0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#cdd6f4" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#6c7086" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#cdd6f4" FontSize="12"
                                                       VerticalAlignment="Center" Margin="12,0,8,0" MinWidth="64" TextAlignment="Right"/>
                                            <!-- Look before deleting: handled by one Click handler on the list (Tag says which) -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Classes="rowAction" Tag="show" ToolTip.Tip="{Binding ShowTip}">
                                                    <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13"/>
                                                </Button>
                                                <Button Classes="rowAction" Tag="open" ToolTip.Tip="{Binding OpenTip}">
                                                    <PathIcon Data="{StaticResource IconOpen}" Width="12" Height="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Panel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Panel>
    </DockPanel>
</UserControl>
