    <Product>Grepdesk</Product>
    <Authors>Furkan Kırat</Authors>
    <Company>Furkan Kırat</Company>
    <Copyright>Copyright (c) 2026 Furkan Kırat</Copyright>
  </PropertyGroup>
</Project>
